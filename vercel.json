{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "buildCommand": "npm run build && node scripts/build-vercel.mjs",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/(?:index\\.php|.*\\.php)(?:/.*)?$", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
